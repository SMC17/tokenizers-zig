#!/usr/bin/env bash
# Run the local agent-fleet G1 smoke against this repo.

set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v fleet-smoke >/dev/null 2>&1; then
  exec fleet-smoke --repo "$repo" --mode local "$@"
elif [[ -n "${AGENT_FLEET_DIR:-}" && -x "${AGENT_FLEET_DIR}/fleet-smoke" ]]; then
  exec "${AGENT_FLEET_DIR}/fleet-smoke" --repo "$repo" --mode local "$@"
else
  echo "fleet-preflight: 'fleet-smoke' not on PATH and AGENT_FLEET_DIR unset" >&2
  exit 3
fi
