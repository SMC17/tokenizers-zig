#!/usr/bin/env bash
# post-commit hook — auto-regenerate NEXT.md after every commit.
# Activate this hook once per clone:
#   git config core.hooksPath .githooks
#
# Wrapped in `|| true` so a checkpoint failure NEVER aborts a future
# commit (defensive — hook failures during stax-experiment outage
# shouldn't block work).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[[ -z "$REPO_ROOT" ]] && exit 0

"$REPO_ROOT/scripts/checkpoint.sh" >/dev/null 2>&1 || true
